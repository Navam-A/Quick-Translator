{
  "manifest_version": 3,
  "name": "Quick Translator",
  "version": "1.0",
  "description": "Quick Translator browser extension.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "./src/popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
