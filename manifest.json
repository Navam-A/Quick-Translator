{
  "manifest_version": 3,
  "name": "Quick Translator",
  "version": "1.0",
  "description": "Translate selected text on any webpage.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "./src/popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
